# URL pública del sitio (sin barra final).
# Si no se define, se usa https://www.lamandragora.com.pe
PUBLIC_SITE_URL=https://www.lamandragora.com.pe

# Verificación de Google Search Console.
# Search Console > Añadir propiedad > Etiqueta HTML > copia solo el valor de content.
PUBLIC_GSC_VERIFICATION=

# Verificación de Bing Webmaster Tools (etiqueta msvalidate.01).
PUBLIC_BING_VERIFICATION=

# Analítica (opcional). Déjalo vacío para no cargar ningún script.
# Google Analytics 4: ID de medición, por ejemplo G-XXXXXXXXXX.
PUBLIC_GA_ID=
