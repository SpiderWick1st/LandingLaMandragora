---
import { X, MessageCircle } from 'lucide-astro';

interface Props {
  whatsappNumero?: string;
}

const { whatsappNumero = '51999999999' } = Astro.props;
---

<div
  id="dish-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300 overscroll-contain"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  data-whatsapp-phone={whatsappNumero}
>
  <div
    id="dish-modal-card"
    class="relative w-full max-w-lg bg-[#0a0f0b] rounded-3xl overflow-hidden shadow-2xl shadow-black/95 transform scale-95 transition-all duration-300 flex flex-col max-h-[90vh] overscroll-contain"
  >
    <button
      id="close-dish-modal"
      type="button"
      class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/90 hover:bg-brand-950 border border-white/20 hover:border-brand-400 text-white flex items-center justify-center transition-all cursor-pointer shadow-lg group"
      aria-label="Cerrar vista previa"
    >
      <X
        class="w-5 h-5 text-gray-300 group-hover:text-white group-hover:rotate-90 transition-transform duration-200"
      />
    </button>

    <div
      class="group relative w-full h-64 sm:h-72 bg-neutral-950 overflow-hidden shrink-0 select-none"
    >
      <img
        id="modal-dish-img"
        src=""
        alt=""
        draggable="false"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 pointer-events-none select-none"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-[#0a0f0b] via-transparent to-black/20 pointer-events-none"
      >
      </div>

      <div class="absolute bottom-4 left-5 flex flex-wrap gap-2 z-10">
        <span
          id="modal-dish-category"
          class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-brand-500/40 text-brand-300 text-[11px] font-mono tracking-wider uppercase"
        >
        </span>
        <span
          id="modal-dish-tag"
          class="px-3 py-1 rounded-full bg-brand-950/90 backdrop-blur-md border border-brand-600/40 text-brand-400 text-[11px] font-mono tracking-wider uppercase"
        >
        </span>
      </div>
    </div>

    <div class="p-6 sm:p-7 overflow-y-auto overscroll-contain">
      <div class="flex items-start justify-between gap-4 mb-3">
        <h3
          id="modal-dish-name"
          class="text-2xl sm:text-3xl font-serif text-white tracking-wide"
        >
        </h3>
        <span
          id="modal-dish-price"
          class="text-xl sm:text-2xl font-sans font-bold text-brand-400 shrink-0"
        >
        </span>
      </div>

      <p
        id="modal-dish-description"
        class="text-gray-300 text-sm leading-relaxed mb-6"
      >
      </p>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-brand-950/80"
      >
        <a
          id="modal-whatsapp-btn"
          href=""
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-3 px-4 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-sans tracking-wider flex items-center justify-center gap-2 transition-all shadow-lg shadow-brand-900/30 font-medium"
        >
          <MessageCircle class="w-4 h-4 text-white" />
          <span>Pedir por WhatsApp</span>
        </a>
        <button
          id="modal-close-btn"
          type="button"
          class="w-full py-3 px-4 bg-brand-950/40 hover:bg-brand-900/40 border border-brand-800/40 text-gray-300 hover:text-white rounded-xl text-xs font-sans tracking-wider transition-all cursor-pointer text-center"
        >
          Volver a la carta
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('dish-modal');
  const modalCard = document.getElementById('dish-modal-card');
  const closeBtn = document.getElementById('close-dish-modal');
  const closeBottomBtn = document.getElementById('modal-close-btn');
  const modalImg = document.getElementById(
    'modal-dish-img'
  ) as HTMLImageElement | null;
  const modalName = document.getElementById('modal-dish-name');
  const modalPrice = document.getElementById('modal-dish-price');
  const modalDesc = document.getElementById('modal-dish-description');
  const modalCategory = document.getElementById('modal-dish-category');
  const modalTag = document.getElementById('modal-dish-tag');
  const modalWhatsapp = document.getElementById(
    'modal-whatsapp-btn'
  ) as HTMLAnchorElement | null;

  const whatsappNumero =
    modal?.getAttribute('data-whatsapp-phone') || '51999999999';

  const ITEM_IMAGES: Record<string, string> = {
    'Sinatra Forever':
      'https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=800&q=80',
    'Gimme The Power':
      'https://images.unsplash.com/photo-1551024709-8f23befc6f87?auto=format&fit=crop&w=800&q=80',
    'Marley Punch':
      'https://images.unsplash.com/photo-1536935338788-846bb9981813?auto=format&fit=crop&w=800&q=80',
    'La Mula de X Dinero':
      'https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=800&q=80',
    'Charly Charly':
      'https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=800&q=80',
    'Amy Blake':
      'https://images.unsplash.com/photo-1560512823-829485b8bf24?auto=format&fit=crop&w=800&q=80',
    'Orishas Fashioned':
      'https://images.unsplash.com/photo-1470337458703-46ad1756a187?auto=format&fit=crop&w=800&q=80',
    Magdalena:
      'https://images.unsplash.com/photo-1527661591475-527312dd65f5?auto=format&fit=crop&w=800&q=80',
    'Tropico Oscuro':
      'https://images.unsplash.com/photo-1574096079513-d8259312b785?auto=format&fit=crop&w=800&q=80',
    'Smoke & Strings':
      'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80',
    'Jungle Fire Zombie':
      'https://images.unsplash.com/photo-1541546339599-ecdbfcf77378?auto=format&fit=crop&w=800&q=80',

    'Tequeños de Jamón y Queso':
      'https://images.unsplash.com/photo-1628294895950-9805252327bc?auto=format&fit=crop&w=800&q=80',
    'Tequeños Chicken Thai Roll':
      'https://images.unsplash.com/photo-1541544741938-0af808871cc0?auto=format&fit=crop&w=800&q=80',
    'Papas Parrilleras':
      'https://images.unsplash.com/photo-1576107232684-1279f3908594?auto=format&fit=crop&w=800&q=80',
    'Papas Bravas Carretilleras':
      'https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=800&q=80',
    'Ensalada César':
      'https://images.unsplash.com/photo-1550304943-4f24f54ddde9?auto=format&fit=crop&w=800&q=80',

    'Lomo Saltado':
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
    'Lomo Strogonoff':
      'https://images.unsplash.com/photo-1603360946369-dc9bb6258143?auto=format&fit=crop&w=800&q=80',
    'Enrollado Cordon Bleu':
      'https://images.unsplash.com/photo-1604908176997-125f25cc6f3d?auto=format&fit=crop&w=800&q=80',
    'Fettuccini a la Huancaína con Lomo Saltado':
      'https://images.unsplash.com/photo-1621996346565-e3d5d6281696?auto=format&fit=crop&w=800&q=80',
    'Crispi de Pollo':
      'https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=800&q=80',
    'Costillas de Cerdo BBQ':
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
    'Costillas de Cerdo Búfalo':
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',

    'Hamburguesa Montada Mandrágora':
      'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80',
    'Hamburguesa a lo Pobre':
      'https://images.unsplash.com/photo-1586190848861-99aa4a171e90?auto=format&fit=crop&w=800&q=80',
    'Hamburguesa BBQ Tocino':
      'https://images.unsplash.com/photo-1553979459-d2229ba7433b?auto=format&fit=crop&w=800&q=80',
    'Hamburguesa Mandrágora':
      'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80',

    'Alitas BBQ':
      'https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80',
    'Alitas BBQ Maracuyá':
      'https://images.unsplash.com/photo-1567620832903-9fc6debc209f?auto=format&fit=crop&w=800&q=80',
    'Alitas BBQ Tocino':
      'https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80',
    'Alitas Acevichadas':
      'https://images.unsplash.com/photo-1567620832903-9fc6debc209f?auto=format&fit=crop&w=800&q=80',
    'Alitas Búfalo':
      'https://images.unsplash.com/photo-1608039829572-78524f79c4c7?auto=format&fit=crop&w=800&q=80',
    'Alitas Teriyaki':
      'https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80',
    'Alitas Frutos del Bosque':
      'https://images.unsplash.com/photo-1567620832903-9fc6debc209f?auto=format&fit=crop&w=800&q=80',
    'Combo La Mandrágora':
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
    'Combo Especial LM':
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
  };

  const CATEGORY_FALLBACKS: Record<string, string> = {
    Cócteles:
      'https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=800&q=80',
    Entradas:
      'https://images.unsplash.com/photo-1628294895950-9805252327bc?auto=format&fit=crop&w=800&q=80',
    Platos:
      'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
    Hamburguesas:
      'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80',
    'Alitas & Combos':
      'https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80',
  };

  interface OpenModalOptions {
    name: string;
    price?: string;
    description?: string;
    tag?: string;
    category?: string;
    image?: string;
  }

  let isModalOpen = false;

  function openDishModal(options: OpenModalOptions) {
    const {
      name,
      price = '',
      description = '',
      tag = '',
      category = '',
      image = '',
    } = options;

    const imgSrc =
      image ||
      ITEM_IMAGES[name] ||
      CATEGORY_FALLBACKS[category] ||
      CATEGORY_FALLBACKS['Cócteles'];

    if (modalImg) {
      modalImg.src = imgSrc;
      modalImg.alt = name;
    }
    if (modalName) modalName.textContent = name;
    if (modalPrice) modalPrice.textContent = price;
    if (modalDesc) modalDesc.textContent = description;
    if (modalCategory) modalCategory.textContent = category || 'Especialidad';

    if (modalTag) {
      if (tag) {
        modalTag.textContent = tag;
        modalTag.classList.remove('hidden');
      } else {
        modalTag.classList.add('hidden');
      }
    }

    if (modalWhatsapp) {
      modalWhatsapp.href = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(`Hola La Mandrágora, deseo consultar o pedir: ${name} (${price})`)}`;
    }

    if (modal && modalCard) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
      isModalOpen = true;
    }
  }

  function closeDishModal() {
    if (modal && modalCard) {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      isModalOpen = false;
    }
  }

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest(
      '.menu-item-card'
    ) as HTMLElement | null;
    if (target) {
      openDishModal({
        name: target.getAttribute('data-name') || '',
        price: target.getAttribute('data-price') || '',
        description: target.getAttribute('data-description') || '',
        tag: target.getAttribute('data-tag') || '',
        category: target.getAttribute('data-category') || '',
        image: target.getAttribute('data-image') || '',
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      const activeEl = document.activeElement as HTMLElement | null;
      if (activeEl && activeEl.classList.contains('menu-item-card')) {
        e.preventDefault();
        openDishModal({
          name: activeEl.getAttribute('data-name') || '',
          price: activeEl.getAttribute('data-price') || '',
          description: activeEl.getAttribute('data-description') || '',
          tag: activeEl.getAttribute('data-tag') || '',
          category: activeEl.getAttribute('data-category') || '',
          image: activeEl.getAttribute('data-image') || '',
        });
      }
    }
  });

  closeBtn?.addEventListener('click', closeDishModal);
  closeBottomBtn?.addEventListener('click', closeDishModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeDishModal();
  });
  modal?.addEventListener('dragstart', (e) => {
    e.preventDefault();
  });
  window.addEventListener(
    'wheel',
    (e) => {
      if (!isModalOpen) return;
      const target = e.target as HTMLElement | null;
      if (target && target.closest('#dish-modal-card .overflow-y-auto')) {
        return;
      }
      e.preventDefault();
    },
    { passive: false }
  );

  window.addEventListener(
    'touchmove',
    (e) => {
      if (!isModalOpen) return;
      const target = e.target as HTMLElement | null;
      if (target && target.closest('#dish-modal-card .overflow-y-auto')) {
        return;
      }
      e.preventDefault();
    },
    { passive: false }
  );

  window.addEventListener(
    'keydown',
    (e) => {
      if (e.key === 'Escape') {
        closeDishModal();
        return;
      }
      if (
        isModalOpen &&
        ['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', ' '].includes(e.key)
      ) {
        const target = e.target as HTMLElement | null;
        if (!target || !target.closest('#dish-modal-card .overflow-y-auto')) {
          e.preventDefault();
        }
      }
    },
    { passive: false }
  );
</script>
