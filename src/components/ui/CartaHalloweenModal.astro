---
import {
  ArrowRight,
  Flame,
  FlaskConical,
  Ghost,
  MoonStar,
  Skull,
  Wine,
  X,
} from 'lucide-astro';
import { coctelesHalloween } from '../../data/halloween';
import '../../styles/halloween-modal.css';

const iconMap = {
  flask: FlaskConical,
  ghost: Ghost,
  wine: Wine,
  moon: MoonStar,
  skull: Skull,
  flame: Flame,
};
---

<div
  id="halloween-modal"
  class="halloween-modal fixed inset-0 z-[80] items-center justify-center p-4 sm:p-6"
  aria-hidden="true"
  inert
>
  <div
    data-halloween-close
    class="halloween-backdrop absolute inset-0 bg-black/80 backdrop-blur-md"
  >
  </div>

  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="halloween-modal-title"
    aria-describedby="halloween-modal-desc"
    tabindex="-1"
    data-halloween-initial-focus
    class="halloween-dialog relative flex w-full max-w-4xl flex-col overflow-hidden rounded-sm shadow-2xl shadow-black/70 focus:outline-none"
  >
    <button
      type="button"
      data-halloween-close
      class="mdg-close absolute right-4 top-4 z-20 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full focus:outline-none"
      aria-label="Cerrar la carta de Halloween"
    >
      <X class="h-4 w-4" />
    </button>

    <!-- Cabecera: la raíz que grita -->
    <header
      class="mdg-header relative shrink-0 px-6 pb-6 pt-8 sm:px-10 sm:pb-7"
    >
      <div
        class="flex flex-col items-center gap-5 sm:flex-row sm:items-center sm:gap-8"
      >
        <div class="mdg-figure-wrap relative shrink-0" aria-hidden="true">
          <svg
            class="mdg-svg"
            viewBox="0 0 200 280"
            xmlns="http://www.w3.org/2000/svg"
            overflow="visible"
          >
            <!-- Ondas del grito -->
            <circle class="mdg-ring mdg-ring-1" cx="100" cy="113" r="10"
            ></circle>
            <circle class="mdg-ring mdg-ring-2" cx="100" cy="113" r="10"
            ></circle>
            <circle class="mdg-ring mdg-ring-3" cx="100" cy="113" r="10"
            ></circle>

            <g class="mdg-figure">
              <!-- Hojas -->
              <g class="mdg-leaves">
                <path d="M100 82 C84 56 52 46 30 58 C40 82 76 94 100 82 Z"
                ></path>
                <path d="M100 82 C116 56 148 46 170 58 C160 82 124 94 100 82 Z"
                ></path>
                <path d="M100 82 C88 54 90 22 100 8 C110 22 112 54 100 82 Z"
                ></path>
              </g>
              <g class="mdg-veins">
                <path d="M100 80 C80 66 58 60 38 60"></path>
                <path d="M100 80 C120 66 142 60 162 60"></path>
                <path d="M100 78 L100 22"></path>
              </g>

              <!-- Raíz con forma humana -->
              <path
                class="mdg-root"
                d="M100 82 C118 82 126 98 122 112 C136 118 148 130 150 146 C152 156 144 158 140 150 C134 140 128 138 124 140 C126 168 122 190 120 206 C120 224 126 244 132 262 C128 266 122 262 118 250 C112 236 108 222 100 212 C92 222 88 236 82 250 C78 262 72 266 68 262 C74 244 80 224 80 206 C78 190 74 168 76 140 C72 138 66 140 60 150 C56 158 48 156 50 146 C52 130 64 118 78 112 C74 98 82 82 100 82 Z"
              ></path>
              <g class="mdg-rootlets">
                <path d="M132 262 C136 270 134 276 140 280"></path>
                <path d="M68 262 C64 270 66 276 60 280"></path>
                <path d="M100 212 C98 226 96 238 94 252"></path>
                <path d="M88 150 C94 156 106 156 112 150"></path>
              </g>

              <!-- Rostro -->
              <g class="mdg-face">
                <path d="M86 100 L96 104"></path>
                <path d="M114 100 L104 104"></path>
                <ellipse cx="100" cy="116" rx="4.5" ry="7"></ellipse>
              </g>
            </g>
          </svg>
        </div>

        <div class="text-center sm:text-left">
          <p class="mdg-kicker">La Mandrágora presenta</p>

          <h2
            id="halloween-modal-title"
            class="mdg-title mt-2 text-3xl sm:text-[2.6rem]"
          >
            Elixires de la raíz que grita
          </h2>

          <p
            id="halloween-modal-desc"
            class="mdg-lede mx-auto mt-3 max-w-md text-sm sm:mx-0"
          >
            Cuenta el herbolario que quien arranca la mandrágora oye un grito.
            Seis elixires de temporada, servidos solo al caer la noche.
          </p>
        </div>
      </div>
    </header>

    <!-- Carta -->
    <div
      class="halloween-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 pb-6 pt-6 sm:px-10"
    >
      <ul class="grid gap-x-12 gap-y-7 sm:grid-cols-2">
        {
          coctelesHalloween.map((item) => {
            const Icon = iconMap[item.icon];
            return (
              <li class="mdg-item">
                <div class="flex items-center gap-3">
                  <span class="mdg-seal" aria-hidden="true">
                    <Icon class="h-4 w-4" />
                  </span>
                  <h3 class="mdg-name">{item.name}</h3>
                  <span class="mdg-leader" aria-hidden="true" />
                  <span class="mdg-price">{item.price}</span>
                </div>

                <div class="mdg-item-body">
                  {item.image && (
                    <div class="mdg-thumb">
                      <img
                        src={item.image}
                        alt={`Imagen referencial de ${item.name}`}
                        width="240"
                        height="300"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}

                  <div class="mdg-item-copy">
                    <p class="mdg-desc">{item.description}</p>
                    <p class="mdg-price">{item.tag}</p>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>

    <footer class="mdg-footer shrink-0 px-6 py-4 sm:px-10 sm:py-5">
      <div
        class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="mdg-foot-note">
          Preparados al momento, con raíces y hierbas de la casa.
        </p>

        <div class="flex flex-col gap-2 sm:flex-row">
          <a href="#carta" data-halloween-close class="mdg-btn mdg-btn-primary">
            Ver carta completa
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>
      </div>
    </footer>
  </div>
</div>

<script>
  const modal = document.getElementById('halloween-modal');

  if (modal) {
    const dialog = modal.querySelector<HTMLElement>('[role="dialog"]');
    let lastFocused: HTMLElement | null = null;
    let previousBodyOverflow = '';

    const isOpen = () => modal.classList.contains('is-open');

    const getFocusable = () =>
      Array.from(
        dialog?.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        ) ?? []
      ).filter((element) => element.offsetParent !== null);

    const openModal = (returnFocus: HTMLElement | null = null) => {
      if (isOpen()) return;

      lastFocused =
        returnFocus ??
        (document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null);

      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';

      modal.classList.add('is-open');
      modal.removeAttribute('aria-hidden');
      modal.inert = false;

      window.setTimeout(() => {
        modal
          .querySelector<HTMLElement>('[data-halloween-initial-focus]')
          ?.focus();
      }, 60);
    };

    const closeModal = () => {
      if (!isOpen()) return;

      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      modal.inert = true;
      document.body.style.overflow = previousBodyOverflow;

      lastFocused?.focus?.();
    };

    modal
      .querySelectorAll<HTMLElement>('[data-halloween-close]')
      .forEach((element) => {
        element.addEventListener('click', closeModal);
      });

    document
      .querySelectorAll<HTMLElement>('[data-halloween-open]')
      .forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const mobileMenu = document.getElementById('mobile-menu');
          let returnFocus: HTMLElement | null = null;

          if (
            mobileMenu &&
            !mobileMenu.classList.contains('translate-x-full')
          ) {
            mobileMenu.classList.add('translate-x-full');
            document.body.classList.remove('overflow-hidden');
            returnFocus = document.getElementById('mobile-menu-btn');
          }

          openModal(returnFocus);
        });
      });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeModal();
        return;
      }

      if (event.key !== 'Tab') return;

      const focusable = getFocusable();
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (document.activeElement === dialog) {
        if (event.shiftKey) {
          event.preventDefault();
          last.focus();
        }
        return;
      }

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // La carta de temporada se muestra en cada carga o recarga de la home.
    window.setTimeout(openModal, 1100);
  }
</script>
