---
interface Props {
  name: string;
  price: string;
  description: string;
  tag?: string;
  image?: string;
  class?: string;
}

const { name, price, description, tag, image, class: className } = Astro.props;
const priceOptions = price.split(' / ');
---

<article
  class:list={[
    'menu-item-card group flex gap-4 rounded-sm border border-brand-950/40 bg-neutral-900/20 p-3 transition-all duration-300 hover:border-brand-600/40 hover:bg-neutral-900/40 sm:gap-5 sm:p-4',
    className,
  ]}
>
  <div
    class="relative h-24 w-24 shrink-0 overflow-hidden rounded-sm border border-brand-950/50 bg-neutral-900 sm:h-32 sm:w-32"
  >
    {
      image ? (
        <img
          src={image}
          alt={name}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-brand-800 to-brand-950">
          <span class="font-serif text-2xl text-white/70">LM</span>
        </div>
      )
    }
  </div>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-baseline gap-3">
      <h3 class="font-serif text-lg leading-snug text-white sm:text-xl">
        {name}
      </h3>
      <span
        class:list={[
          'ml-auto shrink-0 text-right font-sans font-bold text-brand-400',
          priceOptions.length > 1
            ? 'flex flex-col items-end text-xs leading-snug sm:text-sm'
            : '',
        ]}
      >
        {
          priceOptions.map((option) => (
            <span class="block whitespace-nowrap">{option}</span>
          ))
        }
      </span>
    </div>

    <p class="mt-1.5 text-sm leading-relaxed text-gray-400">
      {description}
    </p>

    {
      tag && (
        <span class="mt-3 inline-flex w-fit items-center rounded-full border border-brand-800/40 bg-brand-950/40 px-2.5 py-1 text-[10px] uppercase tracking-widest text-brand-300">
          {tag}
        </span>
      )
    }
  </div>
</article>
