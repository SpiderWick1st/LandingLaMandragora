---
import { Star, MapPin, Phone, Mail } from 'lucide-astro';
---

<footer
  class="relative bg-black border-t border-amber-950/20 text-gray-400 py-16 overflow-hidden"
>
  <!-- Elemento de fondo difuminado -->
  <div
    class="absolute -bottom-20 -left-20 w-80 h-80 bg-amber-600/5 rounded-full blur-[60px] pointer-events-none z-0"
  >
  </div>

  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Columna 1: Brand & Bio -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="w-10 h-10 bg-linear-to-br from-amber-600 to-amber-800 rounded-full flex items-center justify-center shadow-lg shadow-amber-900/20 group-hover:scale-105 transition-transform duration-300"
          >
            <span class="font-serif text-lg text-white font-bold">LM</span>
          </div>
          <div>
            <h3 class="text-lg text-white font-serif tracking-wider">
              LA MANDRÁGORA
            </h3>
            <p class="text-[10px] text-amber-500 tracking-widest uppercase">
              Restaurante & Bar Retro
            </p>
          </div>
        </a>

        <!-- Redes Sociales -->
        <div class="flex items-center gap-4 pt-4">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/MANDRAAQP"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-10 h-10 bg-neutral-900 hover:bg-amber-600 border border-neutral-800 hover:border-amber-500 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110 shadow-md hover:shadow-amber-600/20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
              ></path>
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/mandragora_aqp/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 bg-neutral-900 hover:bg-amber-600 border border-neutral-800 hover:border-amber-500 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110 shadow-md hover:shadow-amber-600/20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
          </a>
          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@mandragorarestaurante?_r=1&_t=ZS-9731LsmhydA"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="w-10 h-10 bg-neutral-900 hover:bg-amber-600 border border-neutral-800 hover:border-amber-500 rounded-full flex items-center justify-center text-white transition-all duration-300 hover:scale-110 shadow-md hover:shadow-amber-600/20"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div class="space-y-4">
        <h4
          class="text-white font-serif font-semibold text-sm tracking-widest uppercase"
        >
          Enlaces Rápidos
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="/"
              class="hover:text-amber-500 transition-colors duration-200"
              >Inicio</a
            >
          </li>
          <li>
            <a
              href="#retro"
              class="hover:text-amber-500 transition-colors duration-200"
              >Experiencia Retro</a
            >
          </li>
          <li>
            <a
              href="#pisos"
              class="hover:text-amber-500 transition-colors duration-200"
              >Nuestros Pisos</a
            >
          </li>
          <li>
            <a
              href="#barra"
              class="hover:text-amber-500 transition-colors duration-200"
              >Mixología & Barra</a
            >
          </li>
          <li>
            <a
              href="#carta"
              class="hover:text-amber-500 transition-colors duration-200"
              >Nuestra Carta</a
            >
          </li>
          <li>
            <a
              href="#ubicanos"
              class="hover:text-amber-500 transition-colors duration-200"
              >Ubícanos</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 3: Horarios de Atención -->
      <div class="space-y-4">
        <h4
          class="text-white font-serif font-semibold text-sm tracking-widest uppercase"
        >
          Horario de Atención
        </h4>
        <ul class="space-y-3 text-sm">
          <li class="flex justify-between border-b border-neutral-900 pb-2">
            <span>Domingo a Jueves</span>
            <span class="text-amber-500">16:00 - 12:00</span>
          </li>
          <li class="flex justify-between border-b border-neutral-900 pb-2">
            <span>Viernes a Sábado</span>
            <span class="text-amber-500">16:00 - 01:00</span>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto & Reservas -->
      <div class="space-y-4">
        <h4
          class="text-white font-serif font-semibold text-sm tracking-widest uppercase"
        >
          Ubícanos & Contacto
        </h4>
        <ul class="space-y-3.5 text-sm">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
            <span>Calle San Franciso 300-A<br />Arequipa, Perú</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-5 h-5 text-amber-500 shrink-0" />
            <a
              href="tel:+51987654321"
              class="hover:text-white transition-colors">+51 999 999 999</a
            >
          </li>
          <li class="flex items-center gap-3">
            <Mail class="w-5 h-5 text-amber-500 shrink-0" />
            <a
              href="mailto:reservas@lamandragora.pe"
              class="hover:text-white transition-colors"
              >reservas@lamandragora.pe</a
            >
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra de derechos reservados -->
    <div
      class="border-t border-neutral-900 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-600"
    >
      <p>
        © {new Date().getFullYear()} La Mandrágora Restobar. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a
          href="/politica-de-privacidad"
          class="hover:text-gray-400 transition-colors"
          >Política de Privacidad</a
        >
        <a
          href="/terminos-y-condiciones"
          class="hover:text-gray-400 transition-colors"
          >Términos y Condiciones</a
        >
      </div>
    </div>
  </div>
</footer>
