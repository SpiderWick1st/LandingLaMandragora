<!--Menu desktop -->
<header
  class="fixed top-0 left-0 w-full z-50 bg-[#070708]/50 backdrop-blur-xl transition-all duration-300 py-4"
>
  <div class="container mx-auto px-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <div
        class="w-12 h-12 bg-linear-to-br from-brand-600 to-brand-800 rounded-full flex items-center justify-center"
      >
        <span class="font-serif text-2xl text-white">LM</span>
      </div>
      <div>
        <h1 class="text-xl text-white tracking-wider">LA MANDRÁGORA</h1>
        <p class="text-xs text-brand-500 tracking-widest">RESTAURANTE</p>
      </div>
    </a>

    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul
        class="flex items-center gap-8 list-none m-0 p-0 text-sm text-white tracking-wide"
      >
        <li>
          <a href="/" class="hover:text-brand-500 transition-colors py-2"
            >Inicio</a
          >
        </li>

        <li>
          <a
            href="#ambientes"
            class="hover:text-brand-500 transition-colors py-2">Ambientes</a
          >
        </li>
        <li>
          <a href="#barra" class="hover:text-brand-500 transition-colors py-2"
            >Barra</a
          >
        </li>
        <li>
          <a href="#carta" class="hover:text-brand-500 transition-colors py-2"
            >Carta</a
          >
        </li>
        <li>
          <a
            href="#ubicanos"
            class="inline-flex items-center justify-center px-4 py-2 text-sm text-white bg-black rounded-full hover:bg-brand-600 transition-all duration-200 shadow-sm"
          >
            Ubícanos
          </a>
        </li>
      </ul>
    </nav>
    <button
      id="mobile-menu-btn"
      class="block md:hidden p-2 text-white hover:text-brand-500 focus:outline-none"
      aria-label="Abrir menú"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Menu Mobile -->
<div
  id="mobile-menu"
  class="fixed inset-0 w-full h-screen bg-[#070708]/98 backdrop-blur-3xl md:hidden translate-x-full transition-transform duration-300 ease-in-out z-60 flex flex-col items-center justify-center"
>
  <button
    class="mobile-link absolute top-6 right-6 p-2 text-white hover:text-brand-500 focus:outline-none z-50"
    aria-label="Cerrar menú"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="mb-12 text-center select-none">
    <div
      class="w-16 h-16 bg-linear-to-br from-brand-600 to-brand-800 rounded-full flex items-center justify-center mx-auto mb-3 shadow-lg shadow-brand-900/30"
    >
      <span class="font-serif text-xl text-white">LM</span>
    </div>
    <h2 class="text-xl text-white tracking-wider font-serif">LA MANDRÁGORA</h2>
    <p class="text-xs text-brand-500 tracking-widest uppercase">Restaurante</p>
  </div>

  <nav aria-label="Navegación móvil" class="w-full max-w-xs px-6">
    <ul
      class="flex flex-col gap-6 list-none m-0 p-0 text-xl text-center text-white tracking-widest font-serif animate-fade-in"
    >
      <li>
        <a
          href="/"
          class="mobile-link block hover:text-brand-500 transition-colors py-2 border-b border-brand-950/20"
        >
          Inicio
        </a>
      </li>
      <li>
        <a
          href="#retro"
          class="mobile-link block hover:text-brand-500 transition-colors py-2 border-b border-brand-950/20"
        >
          Retro
        </a>
      </li>
      <li>
        <a
          href="#ambientes"
          class="mobile-link block hover:text-brand-500 transition-colors py-2 border-b border-brand-950/20"
        >
          Pisos
        </a>
      </li>
      <li>
        <a
          href="#barra"
          class="mobile-link block hover:text-brand-500 transition-colors py-2 border-b border-brand-950/20"
        >
          Barra
        </a>
      </li>
      <li>
        <a
          href="#carta"
          class="mobile-link block hover:text-brand-500 transition-colors py-2 border-b border-brand-950/20"
        >
          Carta
        </a>
      </li>
      <li>
        <a
          href="#ubicanos"
          class="mobile-link inline-flex items-center justify-center w-full px-6 py-3 text-base text-white bg-brand-700 rounded-full hover:bg-brand-600 transition-all duration-200 shadow-md font-sans mt-4"
        >
          Ubícanos
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function openMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('translate-x-full');
    document.body.classList.add('overflow-hidden');
  }

  function closeMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.add('translate-x-full');
    document.body.classList.remove('overflow-hidden');
  }

  if (menuBtn) {
    menuBtn.addEventListener('click', openMenu);
  }

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      closeMenu();
    }
  });
</script>
