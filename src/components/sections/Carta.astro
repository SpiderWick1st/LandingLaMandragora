---
import {
  GlassWater,
  CupSoda,
  Utensils,
  ChefHat,
  Hamburger,
  Drumstick,
  Sparkles,
  Wine,
  MessageCircle,
} from 'lucide-astro';
import MenuItem from '../ui/MenuItem.astro';
import {
  cocteles,
  mocktails,
  entradas,
  fuertes,
  hamburguesas,
  alitas_y_combos,
} from '../../data/menu';
---

<section
  id="carta"
  class="relative py-24 bg-black border-t border-brand-950/25"
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-brand-950/10 rounded-full blur-[120px] pointer-events-none z-0"
    >
    </div>
    <div
      class="absolute -left-40 top-1/4 h-125 w-125 rounded-full bg-brand-800/15 blur-[150px]"
    >
    </div>
    <div
      class="absolute -right-40 bottom-1/4 h-125 w-125 rounded-full bg-accent-600/8 blur-[150px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 max-w-7xl z-10 relative">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-serif tracking-wide text-white mb-4">
        NUESTRA CARTA
      </h2>
      <div class="w-24 h-1 bg-brand-600 mx-auto mb-6"></div>
      <p
        class="text-gray-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed"
      >
        Una selección exclusiva de coctelería mística y platos diseñados para
        complementar una noche perfecta de música y buena compañía.
      </p>
    </div>

    <!-- Coctelería de autor (integrada desde la antigua sección Barra) -->
    <div
      class="mb-14 grid items-center gap-8 rounded-sm border border-brand-950/40 bg-neutral-900/20 p-8 md:grid-cols-2 md:p-10"
    >
      <div>
        <span
          class="mb-3 block text-xs font-medium uppercase tracking-[0.22em] text-accent-400"
        >
          Coctelería de autor
        </span>
        <h3 class="font-serif text-3xl text-white sm:text-4xl">
          La barra también es parte del show
        </h3>
        <div class="mt-5 h-1 w-16 bg-brand-600"></div>
      </div>
      <div class="space-y-5">
        <p class="leading-relaxed text-gray-400">
          Nuestro bartender crea cócteles de autor con ingredientes locales y
          técnicas de vanguardia. Cada bebida es una firma propia, pensada para
          acompañar la noche.
        </p>
        <div class="flex flex-wrap gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs tracking-wide text-gray-300"
          >
            <Sparkles class="h-3.5 w-3.5 text-accent-400" />
            Cócteles de autor
          </span>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs tracking-wide text-gray-300"
          >
            <Wine class="h-3.5 w-3.5 text-accent-400" />
            Ingredientes locales
          </span>
        </div>
      </div>
    </div>

    <!-- Pestañas de Categorías (sticky) -->
    <div
      class="sticky top-20 z-30 -mx-6 mb-10 border-y border-brand-950/40 bg-black/90 px-6 py-3 backdrop-blur-xl md:mx-0 md:rounded-sm md:border"
    >
      <div class="md:overflow-x-auto md:scrollbar-none">
        <div
          class="flex flex-col gap-2 md:mx-auto md:w-max md:flex-row md:items-center md:gap-2"
        >
          <div
            class="-mx-1 flex items-center gap-2 overflow-x-auto scrollbar-none px-1 snap-x snap-mandatory md:mx-0 md:overflow-visible md:px-0"
          >
            <span
              class="shrink-0 pl-1 pr-1 text-[10px] font-mono uppercase tracking-[0.2em] text-gray-500"
            >
              Para beber
            </span>
            <button
              data-tab="cocteles"
              class="tab-btn active shrink-0 snap-center px-5 py-2.5 border border-brand-700/30 rounded-full text-sm font-sans tracking-wider text-white bg-brand-950/20 hover:bg-brand-900/30 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <GlassWater class="w-4 h-4 text-brand-500" />
              Cócteles
            </button>
            <button
              data-tab="mocktails"
              class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <CupSoda class="w-4 h-4 text-brand-500" />
              Mocktails
            </button>
          </div>

          <span class="mx-2 hidden h-5 w-px shrink-0 bg-white/10 md:block"
          ></span>

          <div
            class="-mx-1 flex items-center gap-2 overflow-x-auto scrollbar-none px-1 snap-x snap-mandatory md:mx-0 md:overflow-visible md:px-0"
          >
            <span
              class="shrink-0 pl-1 pr-1 text-[10px] font-mono uppercase tracking-[0.2em] text-gray-500"
            >
              Para comer
            </span>
            <button
              data-tab="entradas"
              class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <Utensils class="w-4 h-4 text-brand-500" />
              Entradas
            </button>
            <button
              data-tab="fuertes"
              class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <ChefHat class="w-4 h-4 text-brand-500" />
              Platos
            </button>
            <button
              data-tab="hamburguesas"
              class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <Hamburger class="w-4 h-4 text-brand-500" />
              Hamburguesas
            </button>
            <button
              data-tab="alitas"
              class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
            >
              <Drumstick class="w-4 h-4 text-brand-500" />
              Alitas
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido de la Carta -->
    <div class="relative grid grid-cols-1 items-start">
      <!-- CÓCTELES -->
      <div
        id="menu-cocteles"
        class="menu-category menu-grid col-start-1 row-start-1 grid md:grid-cols-2 gap-4 sm:gap-5 opacity-100 pointer-events-auto transition-all duration-300"
      >
        {
          cocteles.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === cocteles.length - 1 && cocteles.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          cocteles.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-cocteles"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- MOCKTAILS -->
      <div
        id="menu-mocktails"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-4 sm:gap-5 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          mocktails.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === mocktails.length - 1 && mocktails.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          mocktails.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-mocktails"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- ENTRADAS -->
      <div
        id="menu-entradas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-4 sm:gap-5 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          entradas.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === entradas.length - 1 && entradas.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          entradas.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-entradas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- PLATOS FUERTES -->
      <div
        id="menu-fuertes"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-4 sm:gap-5 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          fuertes.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === fuertes.length - 1 && fuertes.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          fuertes.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-fuertes"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- HAMBURGUESAS -->
      <div
        id="menu-hamburguesas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-4 sm:gap-5 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          hamburguesas.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === hamburguesas.length - 1 && hamburguesas.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          hamburguesas.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-hamburguesas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- ALITAS & COMBOS -->
      <div
        id="menu-alitas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-4 sm:gap-5 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          alitas_y_combos.map((item, index) => (
            <MenuItem
              {...item}
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === alitas_y_combos.length - 1 && alitas_y_combos.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          alitas_y_combos.length > 3 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-alitas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tab-btn.active {
    border-color: var(--color-brand-600);
    background-color: rgba(9, 106, 95, 0.15);
    color: #ffffff;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-grid.is-expanded :global(.mobile-hidden) {
    display: flex !important;
    animation: fadeIn 0.35s ease-out forwards;
  }
  @media (min-width: 768px) {
    :global(.last-odd) {
      grid-column: 1 / -1;
      max-width: calc(50% - 10px);
      margin: 0 auto;
      width: 100%;
    }
  }
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const categories = document.querySelectorAll('.menu-category');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-tab');

      buttons.forEach((btn) => {
        btn.classList.remove('active');
        btn.classList.remove('border-brand-700/30');
        btn.classList.remove('bg-brand-950/20');
        btn.classList.add('border-neutral-800');
        btn.classList.add('text-gray-400');
      });

      button.classList.add('active');
      button.classList.remove('border-neutral-800');
      button.classList.remove('text-gray-400');
      button.classList.add('border-brand-700/30');
      button.classList.add('bg-brand-950/20');

      categories.forEach((category) => {
        category.classList.remove('opacity-100', 'pointer-events-auto');
        category.classList.add('opacity-0', 'pointer-events-none');
        category.classList.add('hidden');
        category.classList.remove('is-expanded');
      });

      document.querySelectorAll('[data-toggle-grid]').forEach((btn) => {
        btn.textContent = 'Ver más';
      });

      const activeCategory = document.getElementById(`menu-${target}`);
      if (activeCategory) {
        activeCategory.classList.remove('hidden');
        void activeCategory.offsetWidth;
        activeCategory.classList.remove('opacity-0', 'pointer-events-none');
        activeCategory.classList.add('opacity-100', 'pointer-events-auto');
      }

      // Centra la pestaña activa dentro de su fila, sin mover la página.
      const tabStrip = button.parentElement;
      if (tabStrip) {
        const stripRect = tabStrip.getBoundingClientRect();
        const buttonRect = button.getBoundingClientRect();
        const targetLeft =
          tabStrip.scrollLeft +
          (buttonRect.left - stripRect.left) -
          (stripRect.width - buttonRect.width) / 2;

        tabStrip.scrollTo({
          left: targetLeft,
          behavior: 'smooth',
        });
      }
    });
  });

  const toggleButtons = document.querySelectorAll('[data-toggle-grid]');
  toggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const gridId = btn.getAttribute('data-toggle-grid');
      if (!gridId) return;

      const grid = document.getElementById(gridId);
      if (grid) {
        const isExpanded = grid.classList.toggle('is-expanded');
        btn.textContent = isExpanded ? 'Ver menos' : 'Ver más';
      }
    });
  });
</script>
