---
import {
  GlassWater,
  Utensils,
  ChefHat,
  Hamburger,
  Drumstick,
  X,
  MessageCircle,
} from 'lucide-astro';
import MenuItem from '../ui/MenuItem.astro';
import {
  cocteles,
  entradas,
  fuertes,
  hamburguesas,
  alitas_y_combos,
} from '../../data/menu';
---

<section
  id="carta"
  class="relative py-24 bg-black border-t border-brand-950/25"
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-brand-950/10 rounded-full blur-[120px] pointer-events-none z-0"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 max-w-6xl z-10 relative">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-serif tracking-wide text-white mb-4">
        NUESTRA CARTA
      </h2>
      <div class="w-24 h-1 bg-brand-600 mx-auto mb-6"></div>
      <p
        class="text-gray-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed"
      >
        Una selección exclusiva de coctelería mística y platos diseñados para
        complementar una noche perfecta de música y buena compañía.
      </p>
    </div>

    <!-- Pestañas de Categorías -->
    <div
      class="-mx-6 px-6 md:mx-0 md:px-0 overflow-x-auto scrollbar-none mb-12 snap-x snap-mandatory flex md:justify-center gap-3 pb-2"
    >
      <button
        data-tab="cocteles"
        class="tab-btn active shrink-0 snap-center px-5 py-2.5 border border-brand-700/30 rounded-full text-sm font-sans tracking-wider text-white bg-brand-950/20 hover:bg-brand-900/30 transition-all duration-300 cursor-pointer flex items-center gap-2"
      >
        <GlassWater class="w-4 h-4 text-brand-500" />
        Cócteles
      </button>
      <button
        data-tab="entradas"
        class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
      >
        <Utensils class="w-4 h-4 text-brand-500" />
        Entradas
      </button>
      <button
        data-tab="fuertes"
        class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
      >
        <ChefHat class="w-4 h-4 text-brand-500" />
        Platos
      </button>
      <button
        data-tab="hamburguesas"
        class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
      >
        <Hamburger class="w-4 h-4 text-brand-500" />
        Hamburguesas
      </button>
      <button
        data-tab="alitas"
        class="tab-btn shrink-0 snap-center px-5 py-2.5 border border-neutral-800 rounded-full text-sm font-sans tracking-wider text-gray-400 hover:text-white hover:border-brand-900/40 hover:bg-neutral-900/40 transition-all duration-300 cursor-pointer flex items-center gap-2"
      >
        <Drumstick class="w-4 h-4 text-brand-500" />
        Alitas
      </button>
    </div>

    <!-- Contenido de la Carta -->
    <div class="relative grid grid-cols-1 items-start">
      <!-- CÓCTELES -->
      <div
        id="menu-cocteles"
        class="menu-category menu-grid col-start-1 row-start-1 grid md:grid-cols-2 gap-8 opacity-100 pointer-events-auto transition-all duration-300"
      >
        {
          cocteles.map((item, index) => (
            <MenuItem
              {...item}
              category="Cócteles"
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === cocteles.length - 1 && cocteles.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          cocteles.length > 6 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-cocteles"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- ENTRADAS -->
      <div
        id="menu-entradas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-8 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          entradas.map((item, index) => (
            <MenuItem
              {...item}
              category="Entradas"
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === entradas.length - 1 && entradas.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          entradas.length > 6 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-entradas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- PLATOS FUERTES -->
      <div
        id="menu-fuertes"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-8 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          fuertes.map((item, index) => (
            <MenuItem
              {...item}
              category="Platos"
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === fuertes.length - 1 && fuertes.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          fuertes.length > 6 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-fuertes"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- HAMBURGUESAS -->
      <div
        id="menu-hamburguesas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-8 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          hamburguesas.map((item, index) => (
            <MenuItem
              {...item}
              category="Hamburguesas"
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === hamburguesas.length - 1 && hamburguesas.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          hamburguesas.length > 6 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-hamburguesas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>

      <!-- ALITAS & COMBOS -->
      <div
        id="menu-alitas"
        class="menu-category menu-grid col-start-1 row-start-1 md:grid-cols-2 gap-8 opacity-0 pointer-events-none transition-all duration-300 hidden"
      >
        {
          alitas_y_combos.map((item, index) => (
            <MenuItem
              {...item}
              category="Alitas & Combos"
              class={`
              ${index >= 3 ? 'mobile-hidden hidden md:flex' : ''}
              ${index === alitas_y_combos.length - 1 && alitas_y_combos.length % 2 !== 0 ? 'last-odd' : ''}
              `}
            />
          ))
        }
        {
          alitas_y_combos.length > 6 && (
            <div class="col-span-full text-center mt-4 md:hidden">
              <button
                data-toggle-grid="menu-alitas"
                class="toggle-menu-btn px-6 py-3 border border-brand-700/30 rounded-sm text-sm font-sans tracking-wider text-brand-400 hover:text-white hover:bg-brand-950/20 transition-all duration-300 cursor-pointer"
              >
                Ver más
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Modal  -->
  <div
    id="dish-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div
      id="dish-modal-card"
      class="relative w-full max-w-lg bg-[#0a0f0b] border border-brand-500/30 rounded-3xl overflow-hidden shadow-2xl shadow-black/95 transform scale-95 transition-all duration-300 flex flex-col max-h-[90vh]"
    >
      <button
        id="close-dish-modal"
        type="button"
        class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/75 hover:bg-brand-950 border border-white/20 hover:border-brand-400 text-white flex items-center justify-center transition-all cursor-pointer shadow-lg group"
        aria-label="Cerrar vista previa"
      >
        <X
          class="w-5 h-5 text-gray-300 group-hover:text-white group-hover:rotate-90 transition-transform duration-200"
        />
      </button>

      <!-- Imagen referencial -->
      <div
        class="relative w-full h-64 sm:h-72 bg-neutral-950 overflow-hidden shrink-0"
      >
        <img
          id="modal-dish-img"
          src=""
          alt=""
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
        />
        <div
          class="absolute inset-0 `bg-gradient-to-t` from-[#0a0f0b] via-transparent to-black/20 pointer-events-none"
        >
        </div>

        <div class="absolute bottom-4 left-5 flex flex-wrap gap-2 z-10">
          <span
            id="modal-dish-category"
            class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-brand-500/40 text-brand-300 text-[11px] font-mono tracking-wider uppercase"
          >
          </span>
          <span
            id="modal-dish-tag"
            class="px-3 py-1 rounded-full bg-brand-950/90 backdrop-blur-md border border-brand-600/40 text-brand-400 text-[11px] font-mono tracking-wider uppercase"
          >
          </span>
        </div>
      </div>

      <div class="p-6 sm:p-7 overflow-y-auto">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h3
            id="modal-dish-name"
            class="text-2xl sm:text-3xl font-serif text-white tracking-wide"
          >
          </h3>
          <span
            id="modal-dish-price"
            class="text-xl sm:text-2xl font-sans font-bold text-brand-400 shrink-0"
          >
          </span>
        </div>

        <p
          id="modal-dish-description"
          class="text-gray-300 text-sm leading-relaxed mb-6"
        >
        </p>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-brand-950/80"
        >
          <a
            id="modal-whatsapp-btn"
            href=""
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-4 bg-brand-600 hover:bg-brand-500 text-white rounded-xl text-xs font-sans tracking-wider flex items-center justify-center gap-2 transition-all shadow-lg shadow-brand-900/30 font-medium"
          >
            <MessageCircle class="w-4 h-4 text-white" />
            <span>Pedir por WhatsApp</span>
          </a>
          <button
            id="modal-close-btn"
            type="button"
            class="w-full py-3 px-4 bg-brand-950/40 hover:bg-brand-900/40 border border-brand-800/40 text-gray-300 hover:text-white rounded-xl text-xs font-sans tracking-wider transition-all cursor-pointer text-center"
          >
            Volver a la carta
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tab-btn.active {
    border-color: var(--color-brand-600);
    background-color: rgba(9, 106, 95, 0.15);
    color: #ffffff;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-grid.is-expanded :global(.mobile-hidden) {
    display: flex !important;
    animation: fadeIn 0.35s ease-out forwards;
  }
  @media (min-width: 768px) {
    :global(.last-odd) {
      grid-column: 1 / -1;
      max-width: calc(50% - 16px);
      margin: 0 auto;
      width: 100%;
    }
  }
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const categories = document.querySelectorAll('.menu-category');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-tab');

      buttons.forEach((btn) => {
        btn.classList.remove('active');
        btn.classList.remove('border-brand-700/30');
        btn.classList.remove('bg-brand-950/20');
        btn.classList.add('border-neutral-800');
        btn.classList.add('text-gray-400');
      });

      button.classList.add('active');
      button.classList.remove('border-neutral-800');
      button.classList.remove('text-gray-400');
      button.classList.add('border-brand-700/30');
      button.classList.add('bg-brand-950/20');

      categories.forEach((category) => {
        category.classList.remove('opacity-100', 'pointer-events-auto');
        category.classList.add('opacity-0', 'pointer-events-none');
        category.classList.add('hidden');
        category.classList.remove('is-expanded');
      });

      document.querySelectorAll('[data-toggle-grid]').forEach((btn) => {
        btn.textContent = 'Ver más';
      });

      const activeCategory = document.getElementById(`menu-${target}`);
      if (activeCategory) {
        activeCategory.classList.remove('hidden');
        void activeCategory.offsetWidth;
        activeCategory.classList.remove('opacity-0', 'pointer-events-none');
        activeCategory.classList.add('opacity-100', 'pointer-events-auto');
      }
      button.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center',
      });

      const section = document.getElementById('carta');
      if (section) {
        const headerOffset = 90;
        const elementPosition = section.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.scrollY - headerOffset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth',
        });
      }
    });
  });

  const toggleButtons = document.querySelectorAll('[data-toggle-grid]');
  toggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const gridId = btn.getAttribute('data-toggle-grid');
      if (!gridId) return;

      const grid = document.getElementById(gridId);
      if (grid) {
        const isExpanded = grid.classList.toggle('is-expanded');
        btn.textContent = isExpanded ? 'Ver menos' : 'Ver más';
      }
    });
  });

  // Lógica del Modal de Vista Previa de Platos / Cócteles
  const modal = document.getElementById('dish-modal');
  const modalCard = document.getElementById('dish-modal-card');
  const closeBtn = document.getElementById('close-dish-modal');
  const closeBottomBtn = document.getElementById('modal-close-btn');
  const modalImg = document.getElementById(
    'modal-dish-img'
  ) as HTMLImageElement | null;
  const modalName = document.getElementById('modal-dish-name');
  const modalPrice = document.getElementById('modal-dish-price');
  const modalDesc = document.getElementById('modal-dish-description');
  const modalCategory = document.getElementById('modal-dish-category');
  const modalTag = document.getElementById('modal-dish-tag');
  const modalWhatsapp = document.getElementById(
    'modal-whatsapp-btn'
  ) as HTMLAnchorElement | null;

  const ITEM_IMAGES: Record<string, string> = {
    // Cócteles Insignia
    'Sinatra Forever':
