<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0">
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source src="/videos/cocktail.mp4" type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 bg-linear-to-b from-black/60 via-black/40 to-black"
    >
    </div>
  </div>

  <div class="text-center z-10">
    <div>
      <div
        id="logo"
        class="w-24 h-24 sm:w-28 sm:h-28 md:w-32 md:h-32 mx-auto bg-linear-to-br from-brand-600 to-brand-900 rounded-full flex items-center justify-center mb-6 shadow-2xl shadow-brand-900/50"
      >
        <span class="font-serif text-4xl text-white sm:text-5xl md:text-6xl"
          >LM</span
        >
      </div>
    </div>
    <h2
      id="la-mandragora-titulo"
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif mb-4 tracking-wide text-white px-4 text-center"
    >
      LA MANDRÁGORA
    </h2>

    <div id="contenido-secundario">
      <p
        class="text-brand-500 text-base sm:text-xl md:text-2xl tracking-widest mb-4 text-center"
      >
        RESTAURANTE
      </p>
      <p
        class="text-gray-300 text-sm sm:text-base md:text-lg lg:text-xl max-w-2xl mx-auto leading-relaxed text-center px-2"
      >
        Una noche para recordar. <br />
        Terraza y Salón: dos experiencias en el corazón de Arequipa.
      </p>
    </div>

    <div
      id="icon-siguiente"
      class="absolute bottom-6 sm:bottom-10 left-1/2 transform -translate-x-1/2 hidden sm:block cursor-pointer"
    >
      <div
        class="w-5 h-8 sm:w-6 sm:h-10 border-2 border-brand-500 rounded-full flex justify-center"
      >
        <div id="icon-punto" class="w-1 h-2 bg-brand-500 rounded-full mt-2">
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion';

  const titulo = document.getElementById('la-mandragora-titulo');
  const contenido = document.getElementById('contenido-secundario');
  const boton = document.getElementById('botones-secundarios');
  const logo = document.getElementById('logo');
  const iconSiguiente = document.getElementById('icon-siguiente');
  const iconPunto = document.getElementById('icon-punto');

  iconSiguiente?.addEventListener('click', () => {
    document.getElementById('ambientes')?.scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    });
  });

  animate(
    logo,
    { scale: [0.8, 1], opacity: [0, 1] },
    { delay: 0.1, duration: 0.6 }
  );

  animate(
    titulo,
    { y: [50, 0], opacity: [0, 1] },
    { delay: 0.3, duration: 0.8 }
  );

  animate(
    contenido,
    { y: [50, 0], opacity: [0, 1] },
    { delay: 0.5, duration: 0.8 }
  );

  animate(
    boton,
    { y: [50, 0], opacity: [0, 1] },
    { delay: 0.7, duration: 0.8 }
  );

  animate(iconSiguiente, { opacity: [0, 1] }, { delay: 1, duration: 1 });

  animate(
    iconPunto,
    { y: [0, 10, 0], opacity: [1, 0.3, 1] },
    { delay: 0, duration: 2, repeat: Infinity }
  );
</script>
