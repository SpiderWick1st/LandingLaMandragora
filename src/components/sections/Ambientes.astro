---
import {
  Building2,
  Music,
  Star,
  Radio,
  Disc3,
  Wine,
  Flame,
  Sparkles,
} from 'lucide-astro';
---

<section id="floors" class="py-24 px-6 bg-black relative overflow-hidden">
  <div class="container mx-auto max-w-6xl relative z-10">
    <div class="reveal text-center mb-20">
      <h3 class="text-4xl md:text-6xl font-serif mb-6 text-white">
        Tres Pisos, Tres Ambientes
      </h3>
      <div class="w-24 h-1 bg-brand-500 mx-auto mb-8"></div>
      <p class="text-gray-300 text-lg max-w-3xl mx-auto">
        Cada nivel de LA MANDRÁGORA ofrece una experiencia única. Elige tu vibe.
      </p>
    </div>

    <div class="space-y-12">
      <!-- Piso 2 - Banda en Vivo -->
      <div class="reveal grid md:grid-cols-2 gap-8 items-center">
        <div>
          <div
            class="hover-scale inline-flex items-center gap-3 mb-6 bg-brand-700 px-6 py-3 rounded-full"
          >
            <span class="text-2xl text-white">Piso 1</span>
          </div>
          <h4 class="text-3xl md:text-4xl font-serif mb-6">Música en Vivo</h4>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            Sube al segundo piso y sumérgete en la experiencia de bandas en
            vivo. Rock, jazz, blues y más géneros se apoderan del escenario cada
            noche. Siente la vibración de la música en vivo en un ambiente
            íntimo y retro.
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-brand-500">
              <Music class="w-5 h-5" />
              <span class="text-white">Bandas en Vivo</span>
            </div>
            <div class="flex items-center gap-3 text-brand-500">
              <Star class="w-5 h-5" />
              <span class="text-white">Shows Todas las Noches</span>
            </div>
            <div class="flex items-center gap-3 text-brand-500">
              <Radio class="w-5 h-5" />
              <span class="text-white">Géneros Variados</span>
            </div>
          </div>
        </div>
        <div class="relative h-96 overflow-hidden rounded-sm group">
          <img
            src="https://images.unsplash.com/photo-1526478806334-5fd488fcaabc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwyfHxsaXZlJTIwYmFuZCUyMG11c2ljJTIwcGVyZm9ybWFuY2UlMjBiYXJ8ZW58MXx8fHwxNzc5NDk1MTEwfDA&ixlib=rb-4.1.0&q=80&w=1080"
            alt="Banda tocando en vivo"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-sm animate-glow-pink"></div>
        </div>
      </div>

      <div class="reveal grid md:grid-cols-2 gap-8 items-center">
        <div
          class="relative h-96 overflow-hidden rounded-sm group order-2 md:order-1"
        >
          <img
            src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxkaiUyMG5pZ2h0Y2x1YiUyMHBhcnR5JTIwbXVzaWN8ZW58MXx8fHwxNzc5NDk1MTExfDA&ixlib=rb-4.1.0&q=80&w=1080"
            alt="DJ mezclando música"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-sm animate-glow-cyan"></div>
        </div>
        <div class="order-1 md:order-2">
          <div
            class="hover-scale inline-flex items-center gap-3 mb-6 bg-brand-800 px-6 py-3 rounded-full"
          >
            <span class="text-2xl text-white">Piso 2</span>
          </div>
          <h4 class="text-3xl md:text-4xl font-serif mb-6">Zona DJ</h4>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            La cima de LA MANDRÁGORA es pura energía. Nuestros DJs residentes
            mezclan lo mejor de la música electrónica, reggaeton, hip-hop y
            todos los géneros que te hacen mover. La fiesta nunca termina en el
            tercer piso.
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-brand-500">
              <Disc3 class="w-5 h-5" />
              <span class="text-white">DJs Residentes</span>
            </div>
            <div class="flex items-center gap-3 text-brand-500">
              <Radio class="w-5 h-5" />
              <span class="text-white">Música Variada</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hover-scale {
    transition: transform 0.2s ease-out;
  }
  .hover-scale:hover {
    transform: scale(1.05);
  }

  @keyframes glow-amber {
    0%,
    100% {
      box-shadow: 0 0 30px rgba(217, 119, 6, 0.4);
    }
    50% {
      box-shadow: 0 0 60px rgba(217, 119, 6, 0.7);
    }
  }
  @keyframes glow-pink {
    0%,
    100% {
      box-shadow: 0 0 30px rgba(219, 39, 119, 0.4);
    }
    50% {
      box-shadow: 0 0 60px rgba(219, 39, 119, 0.7);
    }
  }
  @keyframes glow-cyan {
    0%,
    100% {
      box-shadow: 0 0 30px rgba(6, 182, 212, 0.4);
    }
    50% {
      box-shadow: 0 0 60px rgba(6, 182, 212, 0.7);
    }
  }
  .animate-glow-amber {
    animation: glow-amber 3s infinite;
  }
  .animate-glow-pink {
    animation: glow-pink 3s infinite;
  }
  .animate-glow-cyan {
    animation: glow-cyan 3s infinite;
  }
</style>

<script>
  // Reemplaza whileInView + viewport={{ once: true }}
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  reveals.forEach((el) => observer.observe(el));
</script>
