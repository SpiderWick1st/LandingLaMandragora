---
import { Image } from 'astro:assets';
import { Music, Star, Radio, Disc3 } from 'lucide-astro';
import terrazaLamparas from '../../assets/galeria/terraza-lamparas.webp';
import salon from '../../assets/galeria/salon.webp';
import { defaultLang, type Lang, useTranslations } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const {
  lang = (Astro.props.lang ?? Astro.currentLocale ?? defaultLang) as Lang,
} = Astro.props;
const t = useTranslations(lang);
---

<section id="ambientes" class="py-24 px-6 bg-black relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute -left-40 top-1/4 h-125 w-125 rounded-full bg-brand-800/20 blur-[150px]"
    >
    </div>
    <div
      class="absolute -right-40 bottom-1/4 h-125 w-125 rounded-full bg-accent-600/10 blur-[150px]"
    >
    </div>
  </div>
  <div class="container mx-auto max-w-6xl relative z-10">
    <div class="reveal text-center mb-20">
      <h2 class="text-4xl md:text-6xl font-serif mb-6 text-white">
        {t('ambientes.title')}
      </h2>
      <div class="w-24 h-1 bg-brand-500 mx-auto mb-8"></div>
      <p class="text-gray-300 text-lg max-w-3xl mx-auto">
        {t('ambientes.desc')}
      </p>
    </div>

    <div class="space-y-12">
      <div class="reveal grid md:grid-cols-2 gap-8 items-center">
        <div>
          <div
            class="hover-scale inline-flex items-center gap-3 mb-6 bg-brand-700 px-6 py-3 rounded-full"
          >
            <span class="text-2xl text-white">{t('ambientes.salon.badge')}</span
            >
          </div>
          <h3 class="text-3xl md:text-4xl font-serif mb-6 text-white">
            {t('ambientes.salon.title')}
          </h3>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            {t('ambientes.salon.desc')}
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-brand-500">
              <Music class="w-5 h-5" />
              <span class="text-white">{t('ambientes.salon.live_bands')}</span>
            </div>
            <div class="flex items-center gap-3 text-brand-500">
              <Star class="w-5 h-5" />
              <span class="text-white"
                >{t('ambientes.salon.shows_nightly')}</span
              >
            </div>
            <div class="flex flex-wrap gap-2 pt-1">
              {
                [
                  t('ambientes.genres.rock'),
                  t('ambientes.genres.jazz'),
                  t('ambientes.genres.blues'),
                ].map((genero) => (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs tracking-wide text-gray-300">
                    <Radio class="w-3 h-3 text-accent-400" />
                    {genero}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-sm group">
          <Image
            src={salon}
            alt={t('ambientes.salon.alt')}
            width={1000}
            widths={[400, 600, 800, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={74}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-sm animate-glow-brand"></div>
        </div>
      </div>

      <div class="reveal grid md:grid-cols-2 gap-8 items-center">
        <div
          class="relative aspect-[4/5] overflow-hidden rounded-sm group order-2 md:order-1"
        >
          <Image
            src={terrazaLamparas}
            alt={t('ambientes.terraza.alt')}
            width={1000}
            widths={[400, 600, 800, 1000]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="webp"
            quality={74}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-sm animate-glow-brand"></div>
        </div>
        <div class="order-1 md:order-2">
          <div
            class="hover-scale inline-flex items-center gap-3 mb-6 bg-brand-800 px-6 py-3 rounded-full"
          >
            <span class="text-2xl text-white"
              >{t('ambientes.terraza.badge')}</span
            >
          </div>
          <h3 class="text-3xl md:text-4xl font-serif mb-6 text-white">
            {t('ambientes.terraza.title')}
          </h3>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            {t('ambientes.terraza.desc')}
          </p>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-brand-500">
              <Disc3 class="w-5 h-5" />
              <span class="text-white"
                >{t('ambientes.terraza.resident_djs')}</span
              >
            </div>
            <div class="flex flex-wrap gap-2 pt-1">
              {
                [
                  t('ambientes.genres.electronic'),
                  t('ambientes.genres.reggaeton'),
                  t('ambientes.genres.hiphop'),
                ].map((genero) => (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs tracking-wide text-gray-300">
                    <Radio class="w-3 h-3 text-accent-400" />
                    {genero}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hover-scale {
    transition: transform 0.2s ease-out;
  }
  .hover-scale:hover {
    transform: scale(1.05);
  }

  @keyframes glow-brand {
    0%,
    100% {
      box-shadow: 0 0 30px rgba(74, 124, 80, 0.35);
    }
    50% {
      box-shadow: 0 0 60px rgba(74, 124, 80, 0.6);
    }
  }
  .animate-glow-brand {
    animation: glow-brand 3.5s infinite;
  }
</style>

<script>
  // Reemplaza whileInView + viewport={{ once: true }}
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  reveals.forEach((el) => observer.observe(el));
</script>
