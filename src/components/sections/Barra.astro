---
import { Star, Sparkles, Wine } from 'lucide-astro';
---

<section
  id="barra"
  class="relative min-h-screen flex items-center justify-center overflow-hidden py-24"
>
  <div
    id="fondo-1"
    class="absolute bottom-50 left-20 w-125 h-125 bg-brand-900/40 rounded-full blur-[130px] pointer-events-none z-0"
  >
  </div>
  <div
    id="fondo-2"
    class="absolute top-12 -right-30 w-125 h-125 bg-brand-900/40 rounded-full blur-[130px] pointer-events-none z-0"
  >
  </div>

  <div class="container mx-auto px-6 max-w-6xl z-10 text-center">
    <Star
      id="barra-star"
      class="w-12 h-12 text-brand-500 mx-auto mb-4"
      fill="currentColor"
    />
    <h2
      id="barra-titulo"
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif mb-4 tracking-wide text-white text-center opacity-0"
    >
      Conoce a nuestros Bartenders Expertos
    </h2>
    <div class="w-24 h-1 bg-brand-600 mx-auto mb-8"></div>

    <div id="contenido-secundario" class="mb-12">
      <p
        class="text-brand-500 text-base sm:text-lg md:text-xl tracking-widest mb-3 text-center"
      >
        Nuestro Bartender Estrella
      </p>
      <p
        class="text-gray-300 text-sm sm:text-base md:text-lg max-w-2xl mx-auto leading-relaxed text-center"
      >
        Maestro de los Cocteles de Autor
      </p>
    </div>

    <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 items-center">
      <div class="relative w-full max-w-150 mx-auto">
        <div
          id="barra-badge"
          class="absolute -top-6 -right-6 bg-linear-to-br from-brand-500 to-brand-700 rounded-full p-4 shadow-2xl z-20 opacity-0 cursor-pointer"
        >
          <Wine class="w-8 h-8 text-white" />
        </div>

        <div
          id="barra-imagen"
          class="relative rounded-sm overflow-hidden shadow-2xl border border-brand-950/20 opacity-0 transition-transform duration-300 ease-out hover:scale-105 cursor-pointer"
        >
          <img
            src="https://images.unsplash.com/photo-1574879948818-1cfda7aa5b1a?auto=format&fit=crop&w=800&q=80"
            alt="Dember preparando cócteles"
            class="w-full h-150 object-cover"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-black via-transparent to-transparent"
          >
          </div>
          <div
            id="barra-card"
            class="absolute bottom-6 left-6 right-6 bg-black/85 backdrop-blur-md p-6 rounded-sm border border-brand-600/30"
          >
            <h4 class="text-xl text-white font-serif mb-1">Maestro Mixólogo</h4>
            <p class="text-xs text-gray-300">
              Más de 10 años creando experiencias únicas
            </p>
          </div>
        </div>
      </div>

      <div
        id="cocteles-autor"
        class="flex flex-col items-start text-left justify-center opacity-0"
      >
        <h4 class="text-3xl text-white md:text-4xl font-serif mb-6">
          Cocteles de Autor
        </h4>
        <p class="text-gray-300 text-lg leading-relaxed mb-6">
          Dember no solo es un bartender, es un artista. Cada coctel que crea es
          único, una firma personal que combina ingredientes locales con
          técnicas de vanguardia. Sus creaciones no siguen recetas, son
          experiencias líquidas diseñadas para sorprender.
        </p>
        <p class="text-gray-400 leading-relaxed mb-8">
          Los cocteles de autor de LA MANDRÁGORA son famosos en la ciudad. Desde
          el clásico "Mandrágora Sour" hasta el innovador "Néctar Retro", cada
          bebida cuenta una historia y celebra los sabores auténticos de nuestra
          región.
        </p>
        <div id="beneficios" class="space-y-4 opacity-0">
          <div class="flex items-center gap-4 text-brand-500">
            <Star class="w-6 h-6" />
            <span class="text-white">Cocteles únicos e irrepetibles</span>
          </div>

          <div class="flex items-center gap-4 text-brand-500">
            <Sparkles class="w-6 h-6" />
            <span class="text-white">Ingredientes 100% locales</span>
          </div>

          <div class="flex items-center gap-4 text-brand-500">
            <Wine class="w-6 h-6" />
            <span class="text-white"
              >Carta signature en constante evolución</span
            >
          </div>
        </div>

        <!-- <div id="boton-cocteles" class="mt-8 opacity-0">
          <a
            href="#carta"
            class="inline-block w-full text-white sm:w-auto px-6 sm:px-8 py-3 sm:py-4 text-center text-sm sm:text-base bg-linear-to-r from-brand-600 to-brand-700 hover:from-brand-700 hover:to-brand-800 transition-all duration-300 rounded-sm tracking-wider shadow-lg shadow-brand-900/50 hover:scale-105 active:scale-95"
          >
            Prueba Nuestros Cocteles
          </a>
        </div> -->
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView } from 'motion';

  const star = document.getElementById('barra-star');
  const titulo = document.getElementById('barra-titulo');
  const imagen = document.getElementById('barra-imagen');
  const card = document.getElementById('barra-card');
  const badge = document.getElementById('barra-badge');
  const contenido = document.getElementById('cocteles-autor');
  const beneficios = document.getElementById('beneficios');
  const boton = document.getElementById('boton-cocteles');
  const fondo1 = document.getElementById('fondo-1');
  const fondo2 = document.getElementById('fondo-2');

  const stopInView = inView(
    '#barra',
    () => {
      animate(
        fondo1,
        { opacity: [1, 0.3, 1] },
        { duration: 8, repeat: Infinity }
      );
      animate(
        fondo2,
        { opacity: [1, 0.3, 1] },
        { duration: 8, repeat: Infinity }
      );

      if (star) {
        animate(
          star,
          { rotate: [0, 5, -5, 0] },
          { duration: 3, repeat: Infinity }
        );
      }

      if (card) {
        animate(
          card,
          {
            boxShadow: [
              '0 0 20px rgba(9,106,95,0.3)',
              '0 0 40px rgba(9,106,95,0.6)',
              '0 0 20px rgba(9,106,95,0.3)',
            ],
          },
          { duration: 2, repeat: Infinity }
        );
      }

      if (badge) {
        animate(
          badge,
          { y: [0, -10, 0], rotate: [0, 5, -5, 0] },
          { duration: 4, repeat: Infinity, ease: 'easeInOut' }
        );
      }

      if (titulo) {
        animate(titulo, { y: [50, 0], opacity: [0, 1] }, { duration: 0.8 });
      }

      if (imagen) {
        animate(
          imagen,
          { x: [-50, 0], opacity: [0, 1] },
          { delay: 0.2, duration: 0.8 }
        );
      }

      if (badge) {
        animate(
          badge,
          { scale: [0.5, 1], opacity: [0, 1] },
          { delay: 0.4, duration: 1 }
        );
      }

      if (contenido) {
        animate(
          contenido,
          { x: [50, 0], opacity: [0, 1] },
          { delay: 0.4, duration: 1 }
        );
      }

      if (beneficios) {
        animate(
          beneficios,
          { y: [30, 0], opacity: [0, 1] },
          { delay: 0.6, duration: 0.6 }
        );
      }

      if (boton) {
        animate(
          boton,
          { y: [20, 0], opacity: [0, 1] },
          { delay: 0.8, duration: 0.6 }
        );
      }

      stopInView();
    },
    { amount: 0.3 }
  );
</script>
