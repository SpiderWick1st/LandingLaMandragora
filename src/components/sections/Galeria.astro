---
import { Image } from 'astro:assets';
import { Camera } from 'lucide-astro';

import banda from '../../assets/galeria/banda.webp';
import musico from '../../assets/galeria/Musico.webp';
import barra from '../../assets/galeria/barra.webp';
import bartender from '../../assets/galeria/bartender.webp';
import clientes from '../../assets/galeria/clientes.webp';
import terrazaLamparas from '../../assets/galeria/terraza-lamparas.webp';
import terrazaAtardecer from '../../assets/galeria/terraza-atardecer.webp';
import comida from '../../assets/galeria/comida.webp';
import bbq from '../../assets/galeria/bbq.webp';
import dj from '../../assets/galeria/Dj.webp';

const destacadas = [
  {
    src: musico,
    alt: 'Músico tocando la guitarra en vivo en La Mandrágora',
    caption: 'Música en vivo',
  },
  {
    src: bartender,
    alt: 'Bartender de La Mandrágora con coctelera',
    caption: 'Bartender',
  },
];

const fotos = [
  {
    src: banda,
    alt: 'Banda tocando en vivo en La Mandrágora',
    caption: 'Música en vivo',
    ratio: 'aspect-[3/2]',
  },
  {
    src: barra,
    alt: 'Bartender preparando cócteles en la barra de La Mandrágora',
    caption: 'Barra',
    ratio: 'aspect-[2/3]',
  },

  {
    src: comida,
    alt: 'Hamburguesa con papas fritas de La Mandrágora',
    caption: 'Cocina',
    ratio: 'aspect-square',
  },
  {
    src: dj,
    alt: 'DJ mezclando música en la zona DJ de La Mandrágora',
    caption: 'Dj en vivo',
    ratio: 'aspect-[2/3]',
  },
  {
    src: clientes,
    alt: 'Clientes disfrutando de una cerveza en La Mandrágora',
    caption: 'Noches LM',
    ratio: 'aspect-[4/5]',
  },
  {
    src: bbq,
    alt: 'Costillas y alitas con papas fritas de La Mandrágora',
    caption: 'Alitas y costillas',
    ratio: 'aspect-[4/5]',
  },
  {
    src: terrazaAtardecer,
    alt: 'Atardecer sobre Arequipa desde la terraza de La Mandrágora',
    caption: 'Atardecer',
    ratio: 'aspect-[3/4]',
  },
];

const destacadaWidths = [400, 600, 800, 1200];
const destacadaSizes = '(min-width: 1024px) 608px, 50vw';

const masonryWidths = [320, 480, 640, 800];
const masonrySizes = '(min-width: 1024px) 400px, 50vw';
---

<section
  id="galeria"
  class="relative overflow-hidden border-t border-brand-950/25 bg-black py-24"
>
  <div class="pointer-events-none absolute inset-0 z-0">
    <div
      class="absolute -left-40 top-1/4 h-125 w-125 rounded-full bg-brand-800/20 blur-[150px]"
    >
    </div>
    <div
      class="absolute -right-40 bottom-1/4 h-125 w-125 rounded-full bg-accent-600/10 blur-[150px]"
    >
    </div>
  </div>

  <div class="container relative z-10 mx-auto max-w-7xl px-6">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div class="reveal-galeria max-w-2xl border-l-2 border-brand-600/70 pl-6">
        <span
          class="mb-3 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.22em] text-brand-400"
        >
          <Camera class="h-4 w-4" />
          Galería
        </span>
        <h2 class="font-serif text-4xl tracking-wide text-white sm:text-5xl">
          La Mandrágora
        </h2>
        <p class="mt-5 text-base leading-relaxed text-gray-400 sm:text-lg">
          Un vistazo a los ambientes, la barra y la cocina antes de tu visita.
        </p>
      </div>

      <p
        class="reveal-galeria shrink-0 text-xs uppercase tracking-[0.2em] text-gray-500 md:text-right"
      >
        <span class="block">{destacadas.length + fotos.length} momentos</span>
        <span class="mt-1 block text-gray-600">Música · Terraza · Barra</span>
      </p>
    </div>

    <div class="reveal-galeria mt-12">
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {
          destacadas.map((foto) => (
            <figure class="group relative aspect-[3/4] overflow-hidden rounded-sm border border-brand-950/40 bg-neutral-900 sm:aspect-square">
              <Image
                src={foto.src}
                alt={foto.alt}
                width={1200}
                widths={destacadaWidths}
                sizes={destacadaSizes}
                format="webp"
                quality={74}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              />
              <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/55 via-transparent to-transparent" />
              <figcaption class="absolute bottom-4 left-4 inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.22em] text-white/90 drop-shadow-md sm:bottom-5 sm:left-5">
                <span class="h-1.5 w-1.5 rounded-full bg-accent-400" />
                {foto.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="mt-3 columns-2 gap-3 sm:gap-4 lg:columns-3">
        {
          fotos.map((foto) => (
            <figure
              class:list={[
                'group relative mb-3 break-inside-avoid overflow-hidden rounded-sm border border-brand-950/40 bg-neutral-900',
                foto.ratio,
              ]}
            >
              <Image
                src={foto.src}
                alt={foto.alt}
                width={800}
                widths={masonryWidths}
                sizes={masonrySizes}
                format="webp"
                quality={70}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
              />
              <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/55 via-transparent to-transparent opacity-100 transition-opacity duration-300 lg:opacity-0 lg:group-hover:opacity-100" />
              <figcaption class="absolute bottom-3 left-4 inline-flex items-center gap-1.5 text-[10px] uppercase tracking-[0.2em] text-white/90 drop-shadow-md">
                <span class="h-1 w-1 rounded-full bg-accent-400" />
                {foto.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .reveal-galeria {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.7s ease-out,
      transform 0.7s ease-out;
  }
  .reveal-galeria.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-galeria {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const galeriaReveals = document.querySelectorAll('.reveal-galeria');
  const galeriaObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          galeriaObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  galeriaReveals.forEach((element) => galeriaObserver.observe(element));
</script>
