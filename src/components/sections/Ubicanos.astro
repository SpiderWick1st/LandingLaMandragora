---
import { MapPin, ExternalLink } from 'lucide-astro';
---

<section
  id="Ubicanos"
  class="relative py-24 bg-black border-t border-brand-950/25"
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-brand-950/10 rounded-full blur-[120px]"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    <div class="text-center mb-16">
      <MapPin class="w-10 h-10 text-brand-500 mx-auto mb-4" />
      <h2 class="text-4xl sm:text-5xl font-serif tracking-wide text-white mb-4">
        ENCUÉNTRANOS
      </h2>
      <div class="w-24 h-1 bg-brand-600 mx-auto mb-6"></div>
      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto">
        Calle San Francisco 300-A, Arequipa, Perú
      </p>
    </div>

    <div
      class="rounded-sm overflow-hidden border border-brand-950/30 h-96 w-full mb-6"
    >
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d239.2224586552962!2d-71.5351857130956!3d-16.39639511952254!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91424b969dae1eaf%3A0x264b48a8ab6dd333!2sLa%20mandragora%20restaurante!5e0!3m2!1ses-419!2spe!4v1781038090073!5m2!1ses-419!2spe"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <div class="text-center">
      <a
        href="https://maps.app.goo.gl/o7EyfWAxZEs3tiJJ8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3
        border border-brand-600 rounded-sm text-sm font-sans tracking-wider
        text-white bg-brand-950/20 hover:bg-brand-900/30 transition-all
        duration-300"
      >
        <ExternalLink class="w-4 h-4 text-brand-500" />
        Abrir en Google Maps
      </a>
    </div>
  </div>
</section>
