---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'La Mandrágora Restaurant | Arequipa',
  description = 'Restaurante con coctelería de autor en el corazón de Arequipa. Terraza y salón, cocina a la carta y música en vivo.',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import caesarDressingUrl from '../assets/fonts/caesar-dressing-latin-400.woff2?url';
import karlaUrl from '../assets/fonts/karla-latin-wght-normal.woff2?url';
import '../styles/global.css';

const site = Astro.site ?? new URL('https://www.lamandragora.com.pe');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070708" />

    <link
      rel="preload"
      href={caesarDressingUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={karlaUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Mandrágora Restaurante" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La Mandrágora Restaurante" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {
      import.meta.env.PUBLIC_GSC_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GSC_VERIFICATION}
        />
      )
    }
    {
      import.meta.env.PUBLIC_BING_VERIFICATION && (
        <meta
          name="msvalidate.01"
          content={import.meta.env.PUBLIC_BING_VERIFICATION}
        />
      )
    }

    <script>
      import '../scripts/analytics';
    </script>

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Navegación interna sin mostrar #ancla en la URL
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.(
          'a[href^="#"]'
        ) as HTMLAnchorElement | null;
        if (!a || e.defaultPrevented) return;
        const id = a.getAttribute('href')!.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        if (!el && location.pathname === '/') return; // ancla inexistente en el inicio
        e.preventDefault();
        if (!el) {
          // Otra página (p. ej. términos): ir al inicio y desplazarse allí
          sessionStorage.setItem('scrollTo', id);
          location.href = '/';
          return;
        }
        el.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', location.pathname + location.search);
      });

      const pending = sessionStorage.getItem('scrollTo');
      if (pending) {
        sessionStorage.removeItem('scrollTo');
        window.addEventListener('load', () => {
          document.getElementById(pending)?.scrollIntoView();
        });
      }
    </script>
  </body>
</html>
