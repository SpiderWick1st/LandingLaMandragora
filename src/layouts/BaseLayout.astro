---
interface Props {
  title?: string;
}

const { title = 'La Mandrágora Restobar' } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import caesarDressingUrl from '../assets/fonts/caesar-dressing-latin-400.woff2?url';
import karlaUrl from '../assets/fonts/karla-latin-wght-normal.woff2?url';
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="preload"
      href={caesarDressingUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={karlaUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
