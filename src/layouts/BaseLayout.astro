---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import caesarDressingUrl from '../assets/fonts/caesar-dressing-latin-400.woff2?url';
import karlaUrl from '../assets/fonts/karla-latin-wght-normal.woff2?url';
import '../styles/global.css';
import {
  defaultLang,
  type Lang,
  useTranslations,
  getLocalizedPath,
} from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  lang?: Lang;
}

const currentLang = (Astro.props.lang ??
  Astro.currentLocale ??
  defaultLang) as Lang;
const t = useTranslations(currentLang);

const {
  title = t('seo.title'),
  description = t('seo.description'),
  image = '/og-image.png',
  noindex = false,
  lang = currentLang,
} = Astro.props;

const site = new URL('https://www.lamandragora.com.pe');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
const esURL = new URL(getLocalizedPath(Astro.url.pathname, 'es'), site);
const enURL = new URL(getLocalizedPath(Astro.url.pathname, 'en'), site);
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070708" />

    <link
      rel="preload"
      href={caesarDressingUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={karlaUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Mandrágora" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_PE'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'en' ? 'es_PE' : 'en_US'}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La Mandrágora" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {
      import.meta.env.PUBLIC_GSC_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GSC_VERIFICATION}
        />
      )
    }
    {
      import.meta.env.PUBLIC_BING_VERIFICATION && (
        <meta
          name="msvalidate.01"
          content={import.meta.env.PUBLIC_BING_VERIFICATION}
        />
      )
    }

    <script>
      import '../scripts/analytics';
    </script>

    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Navegación interna sin mostrar #ancla en la URL
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.(
          'a[href^="#"]'
        ) as HTMLAnchorElement | null;
        if (!a || e.defaultPrevented) return;
        const id = a.getAttribute('href')!.slice(1);
        if (!id) return;
        const el = document.getElementById(id);
        const isHome =
          location.pathname === '/' ||
          location.pathname === '/en' ||
          location.pathname === '/en/';
        if (!el && isHome) return; // ancla inexistente en el inicio
        e.preventDefault();
        if (!el) {
          // Otra página (p. ej. términos): ir al inicio del idioma correspondiente y desplazarse allí
          sessionStorage.setItem('scrollTo', id);
          location.href = location.pathname.startsWith('/en') ? '/en/' : '/';
          return;
        }
        el.scrollIntoView({ behavior: 'smooth' });
        history.replaceState(null, '', location.pathname + location.search);
      });

      const pending = sessionStorage.getItem('scrollTo');
      if (pending) {
        sessionStorage.removeItem('scrollTo');
        window.addEventListener('load', () => {
          document.getElementById(pending)?.scrollIntoView();
        });
      }
    </script>
  </body>
</html>
