---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Panel · La Mandrágora</title>
  </head>
  <body class="min-h-screen bg-[#070708] text-gray-300 antialiased">
    <div class="mx-auto max-w-6xl px-6 py-12 sm:px-8">
      <header
        class="mb-8 flex flex-col gap-4 border-b border-white/10 pb-6 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-brand-400">
            Panel interno
          </p>
          <h1 class="mt-2 font-serif text-3xl text-white sm:text-4xl">
            Reservas
          </h1>
        </div>
        <button
          id="btn-nueva"
          type="button"
          class="rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-500"
        >
          Nueva reserva
        </button>
      </header>

      <div class="mb-6 flex flex-wrap gap-3">
        <input
          id="filtro"
          type="search"
          placeholder="Filtrar por nombre, correo o teléfono..."
          class="flex-1 rounded-lg border border-white/10 bg-white/[0.045] px-4 py-2.5 text-sm text-white outline-none placeholder:text-gray-600 focus:border-brand-500"
        />
        <select
          id="filtro-ambiente"
          class="rounded-lg border border-white/10 bg-white/[0.045] px-4 py-2.5 text-sm text-white outline-none focus:border-brand-500"
        >
          <option value="">Todos los ambientes</option>
        </select>
      </div>

      <p
        id="estado"
        class="mb-4 hidden rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3 text-sm"
        role="status"
        aria-live="polite"
      >
      </p>

      <div class="overflow-x-auto rounded-2xl border border-white/10">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead
            class="bg-white/[0.04] text-xs uppercase tracking-wider text-gray-400"
          >
            <tr>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Hora</th>
              <th class="px-4 py-3">Nombre</th>
              <th class="px-4 py-3">Contacto</th>
              <th class="px-4 py-3">Personas</th>
              <th class="px-4 py-3">Ambiente</th>
              <th class="px-4 py-3">Comentario</th>
              <th class="px-4 py-3 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="filas" class="divide-y divide-white/5"></tbody>
        </table>
      </div>
      <p id="vacio" class="hidden py-16 text-center text-sm text-gray-500">
        No hay reservas para mostrar.
      </p>
    </div>

    <div
      id="modal"
      class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-black/80 p-6 backdrop-blur-sm"
    >
      <div
        class="my-8 w-full max-w-2xl rounded-2xl border border-white/10 bg-[#0b0d0c] p-6 sm:p-8"
      >
        <h2 id="modal-titulo" class="font-serif text-2xl text-white">
          Nueva reserva
        </h2>

        <form id="form" class="mt-6 grid gap-4 sm:grid-cols-2">
          <label class="sm:col-span-2">
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Nombre
            </span>
            <input
              name="nombre"
              required
              maxlength="255"
              class="panel-control"
            />
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Teléfono
            </span>
            <input
              name="telefono"
              required
              maxlength="20"
              class="panel-control"
            />
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Correo
            </span>
            <input
              name="correo"
              type="email"
              required
              maxlength="255"
              class="panel-control"
            />
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Fecha
            </span>
            <input name="fecha" type="date" required class="panel-control" />
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Hora
            </span>
            <select name="hora" required class="panel-control">
              <option value="">Selecciona</option>
              {
                [
                  '15:00',
                  '16:00',
                  '17:00',
                  '18:00',
                  '19:00',
                  '20:00',
                  '21:00',
                  '22:00',
                  '23:00',
                ].map((hora) => <option value={hora}>{hora}</option>)
              }
            </select>
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Personas
            </span>
            <input
              name="personas"
              type="number"
              min="1"
              max="50"
              value="2"
              required
              class="panel-control"
            />
          </label>

          <label>
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Ambiente
            </span>
            <input
              name="ambiente"
              required
              maxlength="100"
              placeholder="Salón — Música en vivo"
              class="panel-control"
            />
          </label>

          <label class="sm:col-span-2">
            <span
              class="mb-1.5 block text-xs uppercase tracking-wider text-gray-500"
            >
              Comentario
            </span>
            <textarea
              name="comentario"
              rows="2"
              maxlength="1000"
              class="panel-control resize-none"></textarea>
          </label>

          <p
            id="form-error"
            class="sm:col-span-2 hidden rounded-lg border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"
          >
          </p>

          <div class="flex justify-end gap-3 sm:col-span-2">
            <button
              id="btn-cancelar"
              type="button"
              class="rounded-xl border border-white/15 px-5 py-3 text-sm text-gray-300 transition hover:bg-white/5"
            >
              Cancelar
            </button>
            <button
              id="btn-guardar"
              type="submit"
              class="rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-500 disabled:opacity-60"
            >
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>

<style>
  .panel-control {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.045);
    padding: 0.65rem 0.9rem;
    color: #fff;
    outline: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .panel-control:focus {
    border-color: var(--color-brand-500);
    background: rgba(255, 255, 255, 0.065);
  }

  .panel-control::placeholder {
    color: #4b5563;
  }

  select.panel-control option {
    background: #0b0d0c;
    color: #fff;
  }

  .badge {
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.15rem 0.6rem;
    font-size: 0.7rem;
    color: #9ca3af;
    white-space: nowrap;
  }
</style>

<script>
  interface Reserva {
    id: number;
    nombre: string;
    telefono: string;
    correo: string;
    fecha: string | null;
    hora: string;
    personas: number;
    ambiente: string;
    comentario: string | null;
  }

  const API_BASE = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/+$/, '');
  const RESERVAS_URL = API_BASE ? `${API_BASE}/reservas` : '';

  const filas = document.getElementById('filas') as HTMLTableSectionElement;
  const vacio = document.getElementById('vacio') as HTMLElement;
  const estado = document.getElementById('estado') as HTMLElement;
  const filtro = document.getElementById('filtro') as HTMLInputElement;
  const filtroAmbiente = document.getElementById(
    'filtro-ambiente'
  ) as HTMLSelectElement;

  const modal = document.getElementById('modal') as HTMLElement;
  const modalTitulo = document.getElementById('modal-titulo') as HTMLElement;
  const form = document.getElementById('form') as HTMLFormElement;
  const formError = document.getElementById('form-error') as HTMLElement;
  const btnGuardar = document.getElementById(
    'btn-guardar'
  ) as HTMLButtonElement;
  const btnNueva = document.getElementById('btn-nueva') as HTMLButtonElement;
  const btnCancelar = document.getElementById(
    'btn-cancelar'
  ) as HTMLButtonElement;

  let reservas: Reserva[] = [];
  let editandoId: number | null = null;

  const TIMEOUT_MS = 8000;

  async function api(ruta: string, opciones: RequestInit = {}): Promise<any> {
    const control = new AbortController();
    const temporizador = window.setTimeout(() => control.abort(), TIMEOUT_MS);

    try {
      const response = await fetch(`${RESERVAS_URL}${ruta}`, {
        ...opciones,
        signal: control.signal,
        headers: {
          Accept: 'application/json',
          ...(opciones.body ? { 'Content-Type': 'application/json' } : {}),
          ...opciones.headers,
        },
      });
      const body = await response.json().catch(() => ({}));

      if (!response.ok) {
        const errores = body.errors
          ? Object.values(body.errors as Record<string, string[]>)
              .flat()
              .join(' ')
          : '';

        throw new Error(errores || body.message || `Error ${response.status}.`);
      }

      return body;
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') {
        throw new Error(
          'El servidor tardó demasiado en responder. Inténtalo de nuevo.'
        );
      }

      throw error;
    } finally {
      window.clearTimeout(temporizador);
    }
  }

  function mostrar(mensaje: string, tipo: 'ok' | 'error'): void {
    estado.textContent = mensaje;
    estado.classList.remove('hidden');
    estado.classList.toggle('border-red-500/40', tipo === 'error');
    estado.classList.toggle('text-red-200', tipo === 'error');
    estado.classList.toggle('border-brand-500/40', tipo === 'ok');
    estado.classList.toggle('text-brand-200', tipo === 'ok');

    window.setTimeout(() => estado.classList.add('hidden'), 4000);
  }

  function legible(fecha: string | null): string {
    if (!fecha) return '—';

    const [anio, mes, dia] = fecha.split('-');

    return `${dia}/${mes}/${anio}`;
  }

  function celda(texto: string, clases = ''): HTMLTableCellElement {
    const td = document.createElement('td');
    td.className = `px-4 py-3 align-top ${clases}`;
    td.textContent = texto;

    return td;
  }

  function pintar(): void {
    const busqueda = filtro.value.trim().toLowerCase();
    const ambiente = filtroAmbiente.value;

    const filtradas = reservas.filter((reserva) => {
      const coincideAmbiente = ambiente === '' || reserva.ambiente === ambiente;
      const coincideBusqueda =
        busqueda === '' ||
        [reserva.nombre, reserva.correo, reserva.telefono]
          .join(' ')
          .toLowerCase()
          .includes(busqueda);

      return coincideAmbiente && coincideBusqueda;
    });

    filas.replaceChildren();

    filtradas.forEach((reserva) => {
      const tr = document.createElement('tr');
      tr.className = 'transition hover:bg-white/[0.03]';

      tr.append(celda(legible(reserva.fecha), 'whitespace-nowrap text-white'));
      tr.append(celda(reserva.hora, 'whitespace-nowrap'));

      const contacto = document.createElement('td');
      contacto.className = 'px-4 py-3 align-top';
      contacto.append(
        document.createTextNode(reserva.nombre + ' '),
        Object.assign(document.createElement('div'), {
          className: 'text-xs text-gray-500',
          textContent: `${reserva.telefono} · ${reserva.correo}`,
        })
      );
      tr.append(contacto);

      tr.append(celda(String(reserva.personas)));

      const ambienteTd = document.createElement('td');
      ambienteTd.className = 'px-4 py-3 align-top';
      ambienteTd.append(
        Object.assign(document.createElement('span'), {
          className: 'badge',
          textContent: reserva.ambiente,
        })
      );
      tr.append(ambienteTd);

      tr.append(celda(reserva.comentario ?? '—', 'text-gray-500'));

      const acciones = document.createElement('td');
      acciones.className = 'px-4 py-3 text-right whitespace-nowrap';

      const editar = document.createElement('button');
      editar.type = 'button';
      editar.className =
        'rounded-lg border border-white/15 px-3 py-1.5 text-xs text-gray-200 transition hover:bg-white/5';
      editar.textContent = 'Editar';
      editar.addEventListener('click', () => abrirFormulario(reserva));

      const borrar = document.createElement('button');
      borrar.type = 'button';
      borrar.className =
        'ml-2 rounded-lg border border-red-500/40 px-3 py-1.5 text-xs text-red-200 transition hover:bg-red-500/10';
      borrar.textContent = 'Eliminar';
      borrar.addEventListener('click', () => eliminar(reserva));

      acciones.append(editar, borrar);
      tr.append(acciones);
      filas.append(tr);
    });

    vacio.classList.toggle('hidden', filtradas.length > 0);
  }

  async function cargar(): Promise<void> {
    if (!RESERVAS_URL) {
      mostrar('Falta configurar PUBLIC_API_URL.', 'error');
      return;
    }

    try {
      const body = await api('');

      reservas = (body.data ?? body) as Reserva[];

      pintar();
      recargarAmbientes();
    } catch (error) {
      mostrar(
        error instanceof Error
          ? error.message
          : 'No se pudieron cargar las reservas.',
        'error'
      );
    }
  }

  function recargarAmbientes(): void {
    const ambientes = [
      ...new Set(reservas.map((reserva) => reserva.ambiente)),
    ].sort();
    const seleccionado = filtroAmbiente.value;

    filtroAmbiente.replaceChildren(
      Object.assign(document.createElement('option'), {
        value: '',
        textContent: 'Todos los ambientes',
      })
    );

    ambientes.forEach((ambiente) => {
      filtroAmbiente.append(
        Object.assign(document.createElement('option'), {
          value: ambiente,
          textContent: ambiente,
        })
      );
    });

    filtroAmbiente.value = seleccionado;
  }

  function abrirFormulario(reserva?: Reserva): void {
    editandoId = reserva?.id ?? null;
    modalTitulo.textContent = reserva
      ? `Editar reserva #${reserva.id}`
      : 'Nueva reserva';
    formError.classList.add('hidden');
    form.reset();

    const datos: Record<string, string> = {
      nombre: reserva?.nombre ?? '',
      telefono: reserva?.telefono ?? '',
      correo: reserva?.correo ?? '',
      fecha: reserva?.fecha ?? '',
      hora: reserva?.hora ?? '',
      personas: String(reserva?.personas ?? 2),
      ambiente: reserva?.ambiente ?? '',
      comentario: reserva?.comentario ?? '',
    };

    Object.entries(datos).forEach(([campo, valor]) => {
      const input = form.elements.namedItem(campo);

      if (input) (input as HTMLInputElement).value = valor;
    });

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function cerrarFormulario(): void {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    editandoId = null;
  }

  async function guardar(event: Event): Promise<void> {
    event.preventDefault();

    if (!RESERVAS_URL || !form.reportValidity()) return;

    const data = new FormData(form);
    const comentario = String(data.get('comentario') ?? '').trim();

    const payload = {
      nombre: String(data.get('nombre') ?? '').trim(),
      telefono: String(data.get('telefono') ?? '').trim(),
      correo: String(data.get('correo') ?? '').trim(),
      fecha: String(data.get('fecha') ?? ''),
      hora: String(data.get('hora') ?? ''),
      personas: Number(data.get('personas') ?? 0),
      ambiente: String(data.get('ambiente') ?? '').trim(),
      comentario: comentario === '' ? null : comentario,
    };

    btnGuardar.disabled = true;

    try {
      const esEdicion = editandoId !== null;

      await api(esEdicion ? `/${editandoId}` : '', {
        method: esEdicion ? 'PUT' : 'POST',
        body: JSON.stringify(payload),
      });

      cerrarFormulario();
      mostrar(esEdicion ? 'Reserva actualizada.' : 'Reserva creada.', 'ok');
      await cargar();
    } catch (error) {
      formError.textContent =
        error instanceof Error ? error.message : 'No se pudo guardar.';
      formError.classList.remove('hidden');
    } finally {
      btnGuardar.disabled = false;
    }
  }

  async function eliminar(reserva: Reserva): Promise<void> {
    if (!RESERVAS_URL) return;

    const confirmado = window.confirm(
      `¿Eliminar la reserva de ${reserva.nombre} (${legible(reserva.fecha)} ${reserva.hora})?`
    );

    if (!confirmado) return;

    try {
      await api(`/${reserva.id}`, { method: 'DELETE' });

      mostrar('Reserva eliminada.', 'ok');
      await cargar();
    } catch (error) {
      mostrar(
        error instanceof Error ? error.message : 'No se pudo eliminar.',
        'error'
      );
    }
  }

  btnNueva.addEventListener('click', () => abrirFormulario());
  btnCancelar.addEventListener('click', cerrarFormulario);
  modal.addEventListener('click', (event) => {
    if (event.target === modal) cerrarFormulario();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
      cerrarFormulario();
    }
  });
  form.addEventListener('submit', guardar);
  filtro.addEventListener('input', pintar);
  filtroAmbiente.addEventListener('change', pintar);

  cargar();
</script>
